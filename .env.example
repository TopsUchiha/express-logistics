# --- Required ---
# Neon (or any Postgres) connection string, e.g. postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=
# Secret admin URL (8+ characters: letters, digits, - _ /). The panel lives at https://your-site/<ADMIN_PATH>.
# Without it the admin panel is disabled in production.
ADMIN_PATH=
# One-time key (16+ characters) needed to create the FIRST admin account. Remove it afterwards if you like.
ADMIN_SETUP_KEY=

# --- Your public address (optional) ---
# Used in emails and page metadata. On Vercel it is filled in automatically.
NEXT_PUBLIC_SITE_URL=

# --- Map on the tracking page (optional) ---
# Public Mapbox token (starts with pk.). Restrict it to your domain in the Mapbox dashboard.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# --- Email alerts (optional; the site works without them) ---
# Resend API key, a verified sender address, and who should be alerted about new chats and enquiries.
RESEND_API_KEY=
MAIL_FROM=
ADMIN_NOTIFY_EMAIL=
